# Gemini API Configuration
GEMINI_API_KEY="your-gemini-api-key-here"

# Model Selection (gemini-flash-lite-latest, gemini-3.5-flash-lite, gemini-3.5-flash)
GEMINI_MODEL="gemini-flash-lite-latest"

# Semaphore Concurrency Cap (prevents 429 RESOURCE_EXHAUSTED errors)
MAX_CONCURRENT_REQUESTS=5

# PostgreSQL + pgvector Configuration
DATABASE_URL=postgresql://navigator_user:navigator_password@localhost:5432/navigator_db
POSTGRES_USER=navigator_user
POSTGRES_PASSWORD=navigator_password
POSTGRES_DB=navigator_db
